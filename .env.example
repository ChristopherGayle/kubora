# ── Mexxie Prism — Environment Variables ──────────────────────────
# Copy this file to .env.prod for cloud deployment.
# NEVER commit .env.prod to git (it's in .gitignore).

# ── Optional: API keys for server-side scheduled refresh ──────────
# If set, these allow a future /api/cron/refresh endpoint to fetch
# live stock prices on a schedule without needing browser API keys.
EODHD_API_KEY=your_eodhd_key_here
FINNHUB_API_KEY=your_finnhub_key_here
FMP_API_KEY=your_fmp_key_here

# ── Optional: restrict API access with a shared secret ────────────
# If set, all API requests must include header: x-api-key: VALUE
# Leave empty to allow public access (default — needed for GitHub Pages)
API_SECRET_KEY=

# ── Node environment ───────────────────────────────────────────────
NODE_ENV=production
